#!/bin/bash

here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=.github/scripts/common.sh
. "$here/common.sh"
cd_repo_root

tool="$(find_tool pyflakes3 pyflakes)" || fatal "Could not find pyflakes"

mapfile -t sources < <(python_sources)
if [ "${#sources[@]}" -eq 0 ]; then
    echo "No Python sources to check."
    exit 0
fi

echo "Running pyflakes on the following scripts:"
printf '%s\n' "${sources[@]}"

"$tool" "${sources[@]}" || fatal "pyflakes found issues."
echo "pyflakes passed successfully."
