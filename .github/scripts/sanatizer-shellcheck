#!/bin/bash

here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=.github/scripts/common.sh
. "$here/common.sh"
cd_repo_root

tool="$(find_tool shellcheck)" || fatal "Could not find shellcheck"

if [ $# -gt 0 ]; then
    sources=("$@")
else
    mapfile -t sources < <(shell_sources)
fi
if [ "${#sources[@]}" -eq 0 ]; then
    echo "No shell sources to check."
    exit 0
fi

echo "Running ShellCheck on the following scripts:"
printf '%s\n' "${sources[@]}"

"$tool" -x "${sources[@]}" || fatal "ShellCheck found issues."
echo "ShellCheck passed successfully."
